/* =========================
   chart.js
   グラフ描画専用
========================= */

let myChart = null;

function renderChart() {
  const logs = getLogs();
  const last10 = logs.slice(-10);

  const canvas = document.getElementById("myChart");
  if (!canvas) return;

  // データがない場合
  if (last10.length === 0) {
    if (myChart) {
      myChart.destroy();
      myChart = null;
    }
    return;
  }

  // 古いグラフを削除
  if (myChart) {
    myChart.destroy();
  }

  // 横スクロール幅
  const chartInner = document.querySelector(".chart-inner");
  if (chartInner) {
    chartInner.style.width =
      Math.max(last10.length * 85, window.innerWidth - 30) + "px";
  }

  const ctx = canvas.getContext("2d");

  // ラベル生成
  const labels = last10.map((log, index) => {
    const d = new Date(log.ts ?? log.date);

    const year = d.getFullYear();
    const month = d.getMonth() + 1;
    const day = d.getDate();

    const hour = String(d.getHours()).padStart(2, "0");
    const minute = String(d.getMinutes()).padStart(2, "0");

    const prev =
      index > 0
        ? new Date(last10[index - 1].ts ?? last10[index - 1].date)
        : null;

    const newDay = !prev || prev.toDateString() !== d.toDateString();

    return newDay
      ? `${year}/${month}/${day}\n${hour}:${minute}`
      : `${hour}:${minute}`;
  });

  // データセット生成
  const createDataset = (label, color, data) => ({
    label,
    data,
    borderColor: color,
    backgroundColor: color,
    pointBackgroundColor: color,
    pointBorderColor: "#fff",
    pointRadius: 6,
    pointHoverRadius: 8,
    pointBorderWidth: 3,
    borderWidth: 3,
    tension: 0.6,
    cubicInterpolationMode: "monotone",
    fill: false,
  });

  myChart = new Chart(ctx, {
    type: "line",

    data: {
      labels,

      datasets: [
        createDataset(
          "気分",
          "#2196F3",
          last10.map((l) => l.mood),
        ),

        createDataset(
          "体調",
          "#FFA726",
          last10.map((l) => l.cond),
        ),
      ],
    },

    options: {
      responsive: true,
      maintainAspectRatio: false,

      layout: {
        padding: {
          top: 10,
          bottom: 10,
          left: 5,
          right: 5,
        },
      },

      interaction: {
        mode: "index",
        intersect: false,
      },

      plugins: {
        legend: {
          position: "top",
          labels: {
            usePointStyle: true,
            boxWidth: 10,
            font: {
              size: 12,
            },
          },
        },

        tooltip: {
          titleFont: {
            size: 11,
          },
          bodyFont: {
            size: 11,
          },
        },
      },

      scales: {
        x: {
          grid: {
            display: false,
          },

          ticks: {
            autoSkip: false,
            maxRotation: 45,
            minRotation: 45,

            font: {
              size: 10,
            },
          },
        },

        y: {
          position: "left",
          min: 1,
          max: 10,

          ticks: {
            stepSize: 1,

            callback(value) {
              if (value === 10) return "良い";
              if (value === 5) return "普通";
              if (value === 1) return "低い/悪い";
              return "";
            },

            font: {
              size: 13,
              weight: "bold",
            },

            color: "#333",
            padding: 12,
          },

          grid: {
            color(context) {
              return [1, 5, 10].includes(context.tick.value)
                ? "#e8e8e8"
                : "transparent";
            },

            drawBorder: true,
            lineWidth: 1,
          },
        },
      },
    },
  });
}
