<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InnerNote - Perfect Sync</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: 'Helvetica Neue', Arial, sans-serif; background-color: #f8f9fa; margin: 0; padding: 10px; display: flex; justify-content: center; }
        .container { max-width: 450px; width: 100%; background: white; padding: 20px 0; border-radius: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center; }
        h1 { color: #5C6BC0; font-size: 28px; margin: 5px 0 0 0; }
        .subtitle { color: #888; font-size: 0.75rem; font-weight: bold; margin-bottom: 15px; }
        .diagnosis-area { width: 66.6%; margin: 0 auto 20px auto; text-align: left; }
        .input-section { padding: 0 20px; }
        .label { display: block; text-align: left; font-weight: bold; margin: 8px 0 5px 5px; color: #333; font-size: 15px; }
        .scroll-wrapper { overflow-x: auto; white-space: nowrap; padding: 2px 0 10px 5px; }
        .btn-group-circle { display: inline-flex; gap: 12px; }
        .btn-group-circle button { width: 52px; height: 52px; border-radius: 50%; border: 1px solid #e5e7eb; background: #ffffff; color: #9ca3af; font-size: 18px; cursor: pointer; }
        .btn-group-circle button.active { border: 2px solid #bfdbfe; color: #3b82f6; background-color: #eff6ff; font-weight: bold; }
        textarea { width: 100%; height: 50px; margin: 5px 0 15px 0; padding: 10px; border-radius: 12px; border: none; background-color: #f3f4f6; resize: none; }
        .save-btn { width: 100%; padding: 12px; background-color: #4A90E2; color: white; border: none; border-radius: 30px; font-weight: bold; cursor: pointer; }
        
        /* グラフスクロール用スタイル */
        .chart-container { width: 100%; height: 350px; overflow-x: auto; border-top: 1px solid #eee; margin-top: 20px; }
        #chart-wrapper { height: 300px; position: relative; }
        
        .log-item { text-align: left; padding: 15px; margin: 0 20px 12px; background: #fff; border: 1px solid #e5e7eb; border-radius: 15px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>InnerNote</h1>
        <p class="subtitle">**気分と調子の変化を記録**</p>
        
        <div class="diagnosis-area">
            <select id="diagnosis-select" class="select-box">
                <option value="双極症">双極症</option>
                <option value="うつ病">うつ病</option>
                <option value="その他">その他</option>
            </select>
        </div>

        <div class="input-section">
            <label class="label">今の気分？</label>
            <div class="scroll-wrapper"><div id="mood-btns" class="btn-group-circle"></div></div>
            <label class="label">体の調子？</label>
            <div class="scroll-wrapper"><div id="cond-btns" class="btn-group-circle"></div></div>
            <textarea id="note" placeholder="メモ..."></textarea>
            <button class="save-btn" onclick="saveData()">記録する</button>
        </div>

        <div class="chart-container">
            <div id="chart-wrapper">
                <canvas id="myChart"></canvas>
            </div>
        </div>

        <div id="log-list"></div>
    </div>

    <script>
        const STORAGE_KEY = 'innernote_vfinal_400_logs';
        let mood = 5, cond = 5;

        // ボタン生成
        function initButtons(id, type) {
            const container = document.getElementById(id);
            for(let i=1; i<=10; i++) {
                let btn = document.createElement('button');
                btn.innerText = i;
                if(i===5) btn.classList.add('active');
                btn.onclick = function() {
                    container.querySelectorAll('button').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    if(type === 'mood') mood = i; else cond = i;
                };
                container.appendChild(btn);
            }
        }
        initButtons('mood-btns', 'mood');
        initButtons('cond-btns', 'cond');

        function renderChart(logs) {
            const wrapper = document.getElementById('chart-wrapper');
            // データ数に応じて幅を広げる（1件50px）
            wrapper.style.width = Math.max(window.innerWidth, logs.length * 50) + 'px';
            
            const ctx = document.getElementById('myChart').getContext('2d');
            if(window.myChartInstance) window.myChartInstance.destroy();
            
            window.myChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: logs.map(l => l.date),
                    datasets: [
                        { label: '気分', data: logs.map(l => l.mood), borderColor: '#3b82f6' },
                        { label: '体調', data: logs.map(l => l.cond), borderColor: '#f59e0b' }
                    ]
                },
                options: { responsive: false, maintainAspectRatio: false }
            });
        }

        function saveData() {
            const logs = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            logs.push({ date: new Date().toLocaleString(), mood, cond, note: document.getElementById('note').value });
            localStorage.setItem(STORAGE_KEY, JSON.stringify(logs));
            location.reload();
        }

        window.onload = () => {
            const logs = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            renderChart(logs);
            const list = document.getElementById('log-list');
            logs.slice().reverse().forEach(l => {
                let div = document.createElement('div');
                div.className = 'log-item';
                div.innerHTML = `<strong>${l.date}</strong><br>気分:${l.mood} 調子:${l.cond}<br>${l.note}`;
                list.appendChild(div);
            });
        };
    </script>
</body>
</html>
